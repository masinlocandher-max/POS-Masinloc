# Copy to .env.local for local work, or set these in the deploy environment.

# Supabase public client configuration. These values identify the project but
# never grant service-role access. Keep service-role keys out of Vite variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Deployment sub-path. Leave EMPTY unless a host demands absolute asset URLs.
# An empty value builds with a relative base, which works at "/", at
# "/posmasinloqueño/" and at any preview URL. If you must set it, keep it
# ASCII-only ("/pos-masinloc/"): a non-ASCII base is what caused the 404s.
VITE_BASE_PATH=

# Staging access code. While this is set, the app is locked behind it.
# Leave empty in local development to skip the lock.
VITE_STAGING_ACCESS_CODE=

# Flip to true ONLY at public launch. Also remove the noindex meta tag in
# index.html and relax public/robots.txt at the same time.
VITE_PUBLIC_LAUNCH=false
